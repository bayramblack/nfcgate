<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.NoActionBar.Bridge">
        <item name="android:windowBackground">@color/cyber_background</item>
        <item name="android:colorBackground">@color/cyber_background</item>
        <item name="android:navigationBarColor">@color/cyber_background</item>
        <item name="android:textColorPrimary">@color/cyber_text</item>
        <item name="android:textColorSecondary">@color/cyber_muted</item>
        <item name="colorSurface">@color/cyber_surface</item>
        <item name="colorOnSurface">@color/cyber_text</item>
        <item name="colorSecondary">@color/cyber_cyan</item>
        <item name="colorControlNormal">@color/cyber_muted</item>
        <item name="colorButtonNormal">@color/cyber_raised</item>
        <item name="buttonStyle">@style/CyberButton</item>
        <item name="alertDialogTheme">@style/CyberDialog</item>
        <item name="windowActionBar">false</item>
        <!-- overlay action mode on Toolbar -->
        <item name="windowActionModeOverlay">true</item>
        <!-- colorPrimary is used for coloring the Toolbar -->
        <item name="colorPrimary">@color/cyber_surface</item>
        <!-- colorPrimaryDark is used for coloring the status bar -->
        <item name="colorPrimaryDark">@color/cyber_background</item>
        <!-- colorAccent is used as the default color to tint widgets -->
        <item name="colorAccent">@color/cyber_cyan</item>
        <!-- preferenceTheme is needed for Settings -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
    </style>
    <style name="CyberButton" parent="Widget.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/cyber_cyan</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="CyberDialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/pos_card</item>
        <item name="android:colorBackground">@color/cyber_surface</item>
        <item name="android:textColorPrimary">@color/cyber_text</item>
        <item name="android:textColorSecondary">@color/cyber_muted</item>
        <item name="colorAccent">@color/cyber_cyan</item>
        <item name="colorControlNormal">@color/cyber_muted</item>
    </style>

    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/black</item>
    </style>

    <style name="Hexdump" parent="TextAppearance.AppCompat.Body1">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
