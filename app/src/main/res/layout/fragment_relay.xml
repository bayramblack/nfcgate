<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/cyber_background" android:clipToPadding="false" android:focusableInTouchMode="true" android:descendantFocusability="beforeDescendants">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp" android:background="@android:color/transparent" android:layout_marginBottom="12dp">
            <TextView android:id="@+id/wizard_step" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/cyber_muted" android:textSize="12sp" android:layout_marginBottom="8dp" android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/connection_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/connection_offline" android:textSize="18sp" android:textStyle="bold" android:textColor="#FFFFFF" android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/connection_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/connection_intro" android:textSize="14sp" android:textColor="@color/cyber_muted" android:layout_marginTop="8dp" android:layout_marginBottom="0dp" android:lineSpacingExtra="3dp" />
        </LinearLayout>
        <ProgressBar android:id="@+id/connection_progress" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:visibility="gone" android:layout_marginBottom="12dp" />
        <LinearLayout android:id="@+id/connection_welcome" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/pos_card" android:padding="16dp" android:layout_marginBottom="16dp">
            <Button android:id="@+id/session_create" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/connection_create" android:textSize="16sp" android:textColor="@color/cyber_background" android:backgroundTint="@color/cyber_primary_button" android:minHeight="52dp" android:textAllCaps="false" android:paddingTop="12dp" android:paddingBottom="12dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/pos_button" android:stateListAnimator="@null" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/connection_create_help" android:textColor="@color/cyber_muted" android:padding="8dp" android:layout_marginBottom="12dp" />
            <Button android:id="@+id/session_join" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/connection_join" android:textSize="16sp" android:textColor="@color/cyber_cyan" android:backgroundTint="@color/cyber_secondary_button" android:minHeight="52dp" android:textAllCaps="false" android:paddingTop="12dp" android:paddingBottom="12dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/pos_button" android:stateListAnimator="@null" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/connection_join_help" android:textColor="@color/cyber_muted" android:padding="8dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/connection_room" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="16dp" android:visibility="gone">
            <TextView android:id="@+id/active_session_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/cyber_muted" android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
            <Button android:id="@+id/session_qr" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wizard_invite" android:minHeight="52dp" android:textAllCaps="false" android:textSize="14sp" android:paddingTop="12dp" android:paddingBottom="12dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/pos_button" android:backgroundTint="@color/cyber_secondary_button" android:textColor="@color/cyber_cyan" android:stateListAnimator="@null" />
            <Button android:id="@+id/session_retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sessions_retry" android:visibility="gone" android:minHeight="52dp" android:textAllCaps="false" android:textSize="14sp" android:paddingTop="12dp" android:paddingBottom="12dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/pos_button" android:backgroundTint="@color/cyber_secondary_button" android:textColor="@color/cyber_cyan" android:stateListAnimator="@null" />
        </LinearLayout>
        <RelativeLayout android:id="@+id/relay_workspace" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:minHeight="300dp" android:layout_marginBottom="8dp">
            <RelativeLayout android:id="@+id/lay_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="300dp">
                <LinearLayout android:id="@+id/tag_wait" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:visibility="gone">
                    <ImageView android:id="@+id/nfc_role_icon" android:layout_width="72dp" android:layout_height="72dp" android:src="@drawable/ic_pos_card" android:layout_marginTop="8dp" android:layout_marginBottom="12dp" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/nfc_role_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="21sp" android:textStyle="bold" android:textColor="@color/cyber_text" />
                    <TextView android:id="@+id/tag_wait_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="15sp" android:textColor="@color/cyber_muted" android:layout_marginTop="12dp" android:lineSpacingExtra="4dp" />
                    <TextView android:id="@+id/nfc_activity_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="14sp" android:textColor="@color/cyber_cyan" android:layout_marginTop="20dp" android:accessibilityLiveRegion="polite" />
                    <Button android:id="@+id/nfc_start" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/wizard_start" android:textAllCaps="false" android:textColor="@color/cyber_background" android:background="@drawable/pos_button" android:backgroundTint="@color/cyber_primary_button" android:layout_marginTop="20dp" android:padding="12dp" />
                    <Button style="@style/Widget.AppCompat.Button.Borderless" android:id="@+id/nfc_change_role" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/wizard_change_role" android:textAllCaps="false" android:layout_marginTop="8dp" android:textColor="@color/cyber_muted" />
                </LinearLayout>
                <LinearLayout android:id="@+id/selector" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="4dp" android:layout_marginBottom="12dp">
                    <TextView android:id="@+id/txt_action" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/connection_choose_role" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/cyber_text" android:gravity="start" android:layout_marginBottom="14dp" android:lineSpacingExtra="2dp" />
                    <LinearLayout android:id="@+id/select_tag" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:background="@drawable/session_role_choice" android:clickable="true" android:focusable="true" android:contentDescription="@string/connection_tag" android:minHeight="112dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/connection_tag" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/cyber_text" android:drawableStart="@drawable/ic_pos_terminal" android:drawablePadding="12dp" android:gravity="center_vertical" android:minHeight="32dp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/connection_tag_description" android:textColor="@color/cyber_muted" android:layout_marginTop="10dp" android:textSize="14sp" android:lineSpacingExtra="3dp" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/select_reader" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:layout_marginTop="12dp" android:background="@drawable/session_role_choice" android:clickable="true" android:focusable="true" android:contentDescription="@string/connection_reader" android:minHeight="112dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/connection_reader" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/cyber_text" android:drawableStart="@drawable/ic_pos_card" android:drawablePadding="12dp" android:gravity="center_vertical" android:minHeight="32dp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/connection_reader_description" android:textColor="@color/cyber_muted" android:layout_marginTop="10dp" android:textSize="14sp" android:lineSpacingExtra="3dp" />
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>
        <Button android:id="@+id/session_another" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wizard_change_session" android:visibility="visible" android:minHeight="52dp" android:textAllCaps="false" android:textSize="14sp" android:paddingTop="12dp" android:paddingBottom="12dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/pos_button" android:backgroundTint="@color/cyber_secondary_button" android:textColor="@color/cyber_cyan" android:layout_marginTop="16dp" android:stateListAnimator="@null" />
    </LinearLayout>
</ScrollView>